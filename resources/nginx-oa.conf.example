# OA bleibt ausschließlich auf Loopback; Nginx übernimmt öffentliches HTTPS.
server {
    listen 443 ssl http2;
    server_name oa.example.org;

    ssl_certificate     /etc/letsencrypt/live/oa.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/oa.example.org/privkey.pem;

    client_max_body_size 256m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15m;
    }
}

server {
    listen 80;
    server_name oa.example.org;
    return 301 https://$host$request_uri;
}
